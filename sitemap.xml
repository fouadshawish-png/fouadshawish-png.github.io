---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {%- assign excluded_names = "404.html,robots.txt,sitemap.xml,feed.xml" | split: "," -%}
  {%- assign emitted = "|" -%}

  {%- assign home_loc = "/" | absolute_url -%}
  <url>
    <loc>{{ home_loc }}</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
  </url>
  {%- assign emitted = emitted | append: "|" | append: home_loc | append: "|" -%}

  {%- for page in site.pages -%}
    {%- if page.sitemap == false -%}{% continue %}{%- endif -%}
    {%- if page.url == nil or page.url == "" -%}{% continue %}{%- endif -%}
    {%- if page.url == "/" -%}{% continue %}{%- endif -%}
    {%- if page.url contains "/assets/" -%}{% continue %}{%- endif -%}
    {%- if excluded_names contains page.name -%}{% continue %}{%- endif -%}

    {%- assign loc = page.url | absolute_url -%}
    {%- assign marker = "|" | append: loc | append: "|" -%}
    {%- if emitted contains marker -%}{% continue %}{%- endif -%}

    <url>
      <loc>{{ loc }}</loc>
      <lastmod>{{ page.last_modified_at | default: page.date | default: site.time | date_to_xmlschema }}</lastmod>
    </url>
    {%- assign emitted = emitted | append: marker -%}
  {%- endfor -%}

  {%- for post in site.posts -%}
    <url>
      <loc>{{ post.url | absolute_url }}</loc>
      <lastmod>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</lastmod>
    </url>
  {%- endfor -%}
</urlset>
